--- a/funcs/perfd/src/ptree.h
+++ b/funcs/perfd/src/ptree.h
@@ -0,0 +1,156 @@
+/* VENDORED from Lt-Flash/perfcached a757e59 (src/ptree.h).
+ * Do not edit here - run tools/sync-libperfd.sh. */
