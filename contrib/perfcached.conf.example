# perfcached.conf.example — every option, annotated.
# Copy to /etc/perfcached/perfcached.conf, chmod 640, edit the secrets.
# A commented-out line shows the default where the key has one, otherwise
# an example value; uncomment to change.

[daemon]
# worker threads serving client connections (the peer/cluster thread,
# WAL writer and RDB walker are separate)
workers = 4
# the workers' I/O backend: io_uring, or epoll.  io_uring is used
# only where this host can run it - at start the daemon tries it for real
# (a multishot receive into provided buffers, a cancel, a send, over a
# loopback TCP pair) and falls back to epoll if the kernel is too old
# (it needs 6.0+), kernel.io_uring_disabled is set, or a container's
# seccomp profile refuses it.  The reason is logged and shown in /stats
# io.backend; perfcached -C says what this host would run.  A cluster may
# mix the two: the backend never changes what goes on the wire.
#io = io_uring
# a client whose pipelined replies outrun its socket: at 4 MB of
# replies waiting for it, its further requests wait too and its socket is
# not read - TCP holds the client back - until they drain below 1 MB.  A
# client that reads nothing for this many seconds meanwhile is closed as a
# slow consumer.  (8 MB stays the hard cap for what a client did not ask
# at its own pace: pub/sub pushes, and one reply that alone outgrows it.)
#output_stall_s = 30
# opt-in busy polling: a worker spins on the network device's queue
# for up to this many microseconds before its wait sleeps.  Its effect on
# perfcached is not measured yet - measure it on your own NIC and load
# first; it costs CPU that spins (felt on shared VMs).  Per worker: EPIOCSPARAMS on an epoll worker, NAPI on an
# io_uring worker; both need kernel 6.9+, and a kernel that refuses leaves
# the workers running without it (logged; /stats io.busy_poll says why;
# perfcached -C tells beforehand).  0 = off.
#busy_poll_us = 0
# prefer the busy poll over the device's interrupts - effective only with
# the device's napi_defer_hard_irqs and gro_flush_timeout set
#busy_poll_prefer = no
## 0.7.4: the network link under this node's address, read once a second -
# bytes a second against its speed, drops - for /stats alerts.host.link,
# /metrics perfcached_link_* and the host.link alert below.  auto = the
# device holding [cluster] advertise or a listener's address, else the
# default route's; a VLAN is followed to its bond and an active-backup
# bond to its active slave (re-read every 10 s).  off, or a device name.
#link_monitor = auto
# for a device that reports no speed (virtio): Mb/s, so its share is judged
#link_speed_mbps = 0
# how long a start waits, in seconds, for a configured listener or cluster
# advertise address that is not on the host yet (a container whose network
# comes up after the daemon).  It logs a NOTICE when it starts waiting and
# when the address appears; an address that never appears is still an
# error at the end of the window.  0 = do not wait.
#address_wait_s = 30
# a KEYS walk's time budget per worker turn, in microseconds.  A
# walk takes at least 1,024 hash buckets a turn, then goes on until the
# turn has spent this long, and lets the worker's other connections run.
# Larger: KEYS answers sooner, everyone else on that worker waits longer
# per turn.  0 = the 1,024-bucket floor only (0.4.0's walk).
#keys_turn_us = 250
# client connections across the data doors (native, unix, RESP); unset =
# the smaller of what the descriptor limit and the memory allow.  At the
# limit a client is told why and closed; /stats keeps answering.
#max_clients = 10000
# a privilege secret being guessed: after this many wrong `enable`
# secrets from one address within enable_lockout_s seconds, every enable
# from that address is refused for enable_lockout_s - whatever sends them
# (a dashboard, perfcli, a script).  A right secret clears the address.
# Counted as door.enable_lockouts and door.enable_refused.  0 = off.
#enable_lockout_after = 5
#enable_lockout_s = 60
# how this daemon was installed: auto detects it - a binary
# under /opt/perfcached-* is a prefix install (the release tarballs, the
# self-upgrade's layout), the packages write /usr/share/perfcached/
# INSTALL-MODE, anything else is local (a `make install`).  A package
# install is upgraded by the package manager, so upgrade_stage refuses it
# there; upgrade_status reports the mode.  Set it only when the detection
# is wrong for your layout.
#install_mode = auto
# new connections are refused while less than this stays free of the
# memory the daemon may use (MemAvailable or its cgroup's headroom, less
# the arena's uncommitted ceiling) - so the OOM killer never gets it.
# N% of the memory limit (1-50, kept within 128 MB..4 GB), N MB, N GB, off.
#memory_floor = 15%
# pub/sub: the most bytes of messages waiting for one worker to write them
# to its subscribers, in MB.  A publishing connection that fills a queue to
# half of it is paused until the queue is below a quarter (publish_paused
# on /stats), so what PUBLISH counted is delivered.  Messages relayed from
# peers and keyspace events cannot wait: past the cap they are dropped and
# counted (queue_dropped) - an unbounded queue let one slow subscriber pin
# a node's memory and its shutdown.  Raise it to let publishers run longer
# before a pause, at the price of memory and of how long a loaded node
# takes to exit; 0 = no cap and no pauses, at that price without a limit.
#pubsub_queue_mb = 16
# How often /stats and the status page start counting again: off, or every
# 1d .. 7d (7d: every Monday), at stats_reset_at, local time - every node of
# a fleet in one timezone resets at the same moment.  /metrics is never
# reset: Prometheus computes its own rates.  PERFCACHED_STATS_RESET in the
# environment (off, 1d .. 7d) overrides stats_reset.
#stats_reset = 1d
#stats_reset_at = 00:00
# crit | err | warn | notice | info | dbg (unset: info)
log_level = notice
# whether a client may create, drop, resize and rename collections here -
# with the enable secret ([secrets] enable) as well.  It gates who may
# ORIGINATE a change; a change made on any node reaches every member.
#allow_create = no
# the SLOWLOG threshold, microseconds (Redis's own default)
#slowlog_usec = 10000
# requests to the log: off | all | sampled:N (one in N); their keys
# hashed, in full, or not at all: hashed | full | no
#query_log = off
#query_log_keys = hashed
# one NOTICE line per event (miss, expired, store, remove, all, none;
# comma-separated) - the default for every collection, each of which may
# set its own; at most log_events_rate lines a second, the rest counted;
# log_events_hash = yes logs a hash of the key instead of the key
#log_events = none
#log_events_rate = 100
#log_events_hash = no
# the same events published as Redis keyspace notifications
#notify_events = none
# THE INDEX SIZES ITSELF.  A table splits once it passes grow_at_pct of its
# slots, and is resized down once it has sat below shrink_at_pct (unset: a
# quarter of grow_at_pct) for shrink_cooloff_s since it last split, was
# resized or started.  Once chained records pass leg_stuck_pct of the
# entries the splitter aims at grow_floor_pct instead (0 = never).
# autoscale: auto | floor (never below the configured size) | warn (says
# what auto would do, changes nothing) | off - each collection may set its
# own.
#grow_at_pct = 75
#shrink_at_pct = 0
#shrink_cooloff_s = 60
#leg_stuck_pct = 1
#grow_floor_pct = 50
#autoscale = auto
# a key a JSON command wrote is a JSON document to Redis's type rules
# (strict: WRONGTYPE across the two, as Redis 8) or not (loose) - each
# collection may set its own (REDIS-COMMANDS.md, "Types")
#redis_types = strict
# a table with fewer keys than this skips the lookahead prefetch (it is
# cache-resident, and the prefetch only costs there)
#prefetch_min_keys = 65536
# Where this node's identity and mastership term live, so a restart
# comes back as the SAME node - same id, classified recovering.  Name
# it: the prefix's var/ on a tarball install, /var/lib/perfcached from
# the package (the unit already lets the daemon write there).  tmpfs is
# accepted with a warning: survives a daemon restart, not a reboot.
# Unset = ephemeral, a new node on every start; the log says so.
state_dir = /var/lib/perfcached

[memory]
# The arena each collection's cells live in, per daemon, and the HARD
# ceiling on what this process holds: a write that would push past it is
# REFUSED with `cache full` rather than growing the process.  There is no
# eviction - nothing is thrown out to make room.
#
# It is also the huge-page reservation size.  Those were once different
# things: past the reservation the arena carved from plain malloc, so a
# node with arena_mb = 64 reached 348 MB of RSS while reporting
# arena_free 0.  Sizing a fleet by this number now means something.
#
# Budget generously.  The bound covers the index as well as the data,
# and slab classes leave slack, so the live payload that fits is well
# under the figure here - watch stats.memory.arena_held against
# arena_live rather than assuming.
arena_mb = 1024
# elastic ceiling; the arena may grow to this under pressure (0 = fixed
# at arena_mb).  Set it and THIS becomes the hard ceiling instead.
#arena_cap_mb = 0
# own = the private-anonymous hugepage ladder (MAP_HUGETLB -> THP ->
# 4K, in that order, per-chunk); heap = plain malloc, for debugging
#backing = own
# reclaim: chunks idle past quiet_s are given back to the kernel,
# keeping at least reclaim_keep chunks; cooloff_s throttles the sweep
#reclaim_keep = 1
#reclaim_quiet_s = 5
#reclaim_cooloff_s = 10
#reclaim_giveback = 1
# never give back below this many MB held, and at most shrink_step_mb in
# one tick (0: an eighth of the ceiling)
#reclaim_floor_mb = 0
#shrink_step_mb = 0
# pin: the arena is always mlock()ed if it can be, and a failure is a
# WARNING - the node runs swappable.  require refuses the start instead,
# for a node that must be resident.  RLIMIT_MEMLOCK is what refuses it
# (systemd LimitMEMLOCK=infinity; in an unprivileged container the
# CONTAINER's limit is the one that counts).  no (0.7.5) never locks it,
# so the kernel may swap it.  reclaim_* gives idle groups back either way:
# a locked group is unlocked first, and locked again when it is reused.
#pin = auto
# huge_pages: auto probes MAP_HUGETLB -> THP -> 4K.  off forces plain 4K
# and disables THP for the process, so growing the arena costs many
# cheap faults instead of one 2 MB fault that may wait for compaction.
#huge_pages = auto

[secrets]
# Two DIFFERENT passwords - the daemon refuses to start when they are
# equal.  Clients authenticate with the client secret; nodes seal the
# datagram plane with the cluster secret.  Both are Argon2id-stretched
# into Noise PSKs at startup, never kept in cleartext memory.
# The client line may repeat (up to 8) for zero-downtime rotation.
client = CHANGE-ME-client
# Optional on a standalone daemon (nothing there derives from it); with a
# [cluster] section it is required and must differ from the client secret.
cluster = CHANGE-ME-cluster-DIFFERENT
# A rotation's other cluster secret (0.7.4): opened with, never sealed with.
# Rotate in three rolling restarts - cluster = old, cluster_accept = new on
# every node; then cluster = new, cluster_accept = old; then drop it.
#cluster_accept = THE-OTHER-ONE
# Optional Redis AUTH password for a dedicated RESP listener.
# Stock Redis clients can only send a password, so this is the strongest
# in-band control that dialect allows - and it crosses the wire IN THE
# CLEAR, which is why it must differ from both secrets above (the daemon
# refuses to start if it matches either).
#resp = CHANGE-ME-resp-password
# The SMTP password for [mail] - here, never in [mail] itself.
#mail = CHANGE-ME-smtp-password
# The privilege secret: a connection that presents it (perfcli -E, the
# dashboard's session prompt) may create, drop, resize and rename
# collections, map DB indexes, restore and run the sweeps.  Never empty;
# it may repeat (up to 8).  Without it every such request is refused.
#enable = CHANGE-ME-enable
# A token for the HTTP listener: Authorization: Bearer <token>, or a
# browser's login with the token as the password.
#http = CHANGE-ME-http-token

# Alert mail - needs a build with an SMTP client (make menuconfig:
# mail = libcurl; without it -C refuses this section).  smtp:// upgrades
# with STARTTLS and will not send without it; smtps:// is TLS from the
# first byte.  No credentials in the URL: user here, the password as
# [secrets] mail.  `perfcli -E ... mailtest` sends one test mail.
#[mail]
#smtp = smtp://mail.example.net:587
#user = alerts@example.net
#from = perfcached@example.net
#to = ops@example.net, oncall@example.net
#ca_file = /etc/ssl/certs/internal-ca.pem   # default: the system's CAs
#tls_verify = yes                           # no: TLS without checking the server's
                                            # certificate (an internal relay's self-signed one)
#subject_prefix = [perfcached]              # none by default: the From name says the host
#timeout_s = 30                             # one send, connect to QUIT
#min_interval_s = 900                       # the same alert at most once per window
#digest_s = 60                              # alerts within it go as one mail
#level = warning                            # the lowest mailed: info | warning | critical

# THE HIGH-WATER ALARMS (0.6.0.1) - raised, kept and mailed like every other
# alert.  Each is a warning at *_warn_pct and critical at *_crit_pct (the
# warning below the critical); these are the defaults, so the section is
# only needed to change them.  CPU and disk are averaged over the last
# minute and raised after five minutes over; memory and the arena after
# one.  Each clears five points under its level.
#   cpu    - the host's CPU busy (/proc/stat; perfcached's share is named)
#   io     - the device holding the WAL (or state_dir) busy, as iostat's
#            %util - never iowait, which io_uring inflates before 6.15
#   memory - the host's memory used (MemAvailable), beside the huge-page
#            pool when there is one: the pool is reserved, most often
#            for the arena, and its use is the arena's alert (0.6.4)
#   arena  - the arena's held memory against its ceiling
# And one warning only (0.6.1): a node on epoll whose busiest worker
# spends epoll_busy_pct of its time outside its wait, averaged over a
# minute, for five minutes - with what to change (io = io_uring where the
# host can run it, else what refused it).  Never raised on io_uring.
#[alerts]
#cpu_warn_pct = 65
#cpu_crit_pct = 75
#io_warn_pct = 65
#io_crit_pct = 75
#memory_warn_pct = 65
#memory_crit_pct = 75
#arena_warn_pct = 65
#arena_crit_pct = 75
#epoll_busy_pct = 80
# 0.7.4: the link's busier direction against its speed, over a minute
# (critical at once when cluster datagrams drop at the critical level)
#link_warn_pct = 80
#link_crit_pct = 95

# Which builds this node trusts.  The release key is built in (-E prints
# it); `perfcached -K <tarball> -f <this file>` checks a tarball against
# its .sig with it and these.  trusted_keys: ed25519 public keys, 64 hex
# characters each, up to 4 - for builds you sign yourself.
#[upgrade]
#trusted_keys = <64 hex characters>
#allow_unsigned = no
# the builds staged here for an upgrade, at most this many MB together
#stage_mb = 256
# where the upgrade helper writes its results (its `results` setting)
#results_dir = /var/lib/perfcached-upgrade

[listen]
# client listeners; the native protocol (binary frames) and RESP2 are
# told apart by the first byte of each message
# (redis-cli / hiredis / rtpengine connect unmodified; RESP's
# SELECT n lands on the collection NAMED "n", connections start on
# "0" - name collections [collection 0], [collection 1]... to serve
# Redis clients)
tcp = 0.0.0.0:6479
#unix = /run/perfcached/perfcached.sock
# never = every client proves the client secret (the Noise handshake);
# loopback = 127.0.0.1/::1/unix may skip it
## 0.7.4: after the handshake a client may carry its requests in the clear
# (no = the default, about half the CPU a request; readable on the
# network) or every connection stays encrypted (yes).  One listener can
# differ: tcp = 10.0.0.5:6479 encrypt=yes.  The cluster is always encrypted.
#encrypt = no
## TCP keepalive on every accepted data-door socket (native, unix, RESP):
# a subscriber whose host died silently is found by the kernel, since the
# daemon never closes an idle connection itself.  0 = off.
#keepalive_s = 300
# pub/sub over UDP: a native connection may ask for its deliveries as
# sealed datagrams to its own address (never one it names), sent from
# this door's address and port over UDP - so a client's firewall admits
# them with one rule.  Nothing is sent before the client proves the
# datagrams reach it.  `no` binds no UDP socket and refuses the request.
#pubsub_udp = yes
plaintext = never

# A DEDICATED RESP LISTENER - the way to let LAN Redis clients in.
# It is RESP2 ONLY: the native protocol is refused on it, so the admin
# verbs are unreachable from it by construction.  A Redis client cannot
# speak the Noise channel, so this listener is plaintext unless given
# `tls` (TLS, below) - which is why the guards below are not optional
# decoration:
#   * off-box, resp_allow is REQUIRED or the daemon refuses to start;
#   * without [secrets] resp it warns loudly at startup;
#   * without tls the traffic, AUTH included, is UNENCRYPTED - put it on
#     a trusted segment.
# SELECT n maps onto the collection NAMED n, so declare [collection 0],
# [collection 1] ... to serve Redis clients that expect db indices.
#resp = 192.0.2.31:6379
#resp_allow = 192.0.2.0/24, 198.51.100.5/32
#resp_collections = 0, 1
# What a RESP door does with a key this node does not own, under shard
# and spread (the other modes have no owner to redirect to):
#   forward  the default - answer it, paying the hop.  Right for a plain
#            Redis client and for anything behind a balancer.
#   moved    a genuine "-MOVED <slot> <ip>:<port>" and NO forward, for
#            CLUSTER-AWARE clients: they route by CLUSTER SLOTS and
#            refresh that table on -MOVED and on nothing else, so with
#            `forward` they stay stale for ever after a rebalance.  The
#            address is the owner's own - do not combine with a balancer.
# Per daemon, not per request: the two kinds of client look the same.
#resp_redirect = forward

# THE HTTP LISTENER: /stats, /metrics, /members, /clients and /health -
# read-only, JSON and text (the status page is perfcached-dashboard's
# since 0.7.0: GET / answers 410 and says so, and POST /reset-stats went
# with it - the reset is the native verb).  Off-box it needs http_allow; [secrets] http
# adds a token: Authorization: Bearer <token>, or a browser's login (any
# user, the token as the password).
#http = 192.0.2.31:8080
#http_allow = 192.0.2.0/24
# an HTTP connection that has not sent a whole request this many seconds
# after it opened is closed (0 = never)
#http_timeout = 5
# requests a second per client address, in a bucket of twice that; an
# address asking faster is answered 429 until it slows.  Loopback is not
# limited.  0 = off
#http_rate = 20
# /stats and /metrics are built at most once in this long and the copy is
# served in between - the dashboard polls every 3 s per open tab.  Loopback
# always reads them fresh.  0 = built for every request
#http_cache_ms = 1000

# TLS ON THE RESP AND HTTP DOORS (0.7.5; a build with OpenSSL - perfcached -V
# prints "tls: OpenSSL ..." or "tls: off").  `tls` after the address; a
# plaintext loopback door can stay beside a TLS one.  Clients: redis-cli
# --tls --cacert, rediss:// URLs, Prometheus scheme: https.  The native
# door has its own encryption and takes no `tls`.
#resp = 192.0.2.31:6380 tls
#http = 192.0.2.31:8443 tls
# The certificate (PEM, its chain after it; it must name the address
# clients dial) and its key, readable by the daemon's user.  -C and the
# start check that they match; a reload reads both again, so a renewal is
# `systemctl reload perfcached`.  /stats tls shows the days left, and the
# alert tls.cert warns 14 days before the expiry.
#tls_cert = /etc/perfcached/tls/cert.pem
#tls_key = /etc/perfcached/tls/key.pem
# the oldest TLS version taken: 1.2 | 1.3
#tls_min = 1.2
# A plaintext RESP or HTTP door off loopback with a password or a token is
# warned about at start.  yes: AUTH and the token are refused there, with
# a reply that says so - only TLS and loopback connections may send them.
#auth_needs_tls = no

[wal]
# comment the whole section out for a pure in-memory cache.
# Under systemd, StateDirectory provides /var/lib/perfcached.
dir = /var/lib/perfcached
# storage probe at startup (write+fsync latency): auto | always | no.
# It does two jobs: it recommends an fsync policy for THIS device, and
# it sizes the ring below for fsync = always.  probe = no disables both,
# and the daemon then says so rather than guessing.
#probe = auto
#probe_secs = 2
# fsync policy: everysec (default, <=1s loss) | always | no.
#
# READ THIS BEFORE CHOOSING always.  The pump fsyncs once per drained
# BATCH, so on storage whose fdatasync takes milliseconds it falls
# behind the workers, the ring below fills, and a full ring DROPS the
# record - after the client was told the write succeeded.  Measured
# 2026-08-29 on ms-class storage: fsync = always lost 30-2601 of 20000
# acknowledged writes in every one of six trials, while everysec and no
# lost NOTHING in six each.  The most durable setting was the only lossy
# one.
#
# That is fixed - the probe sizes the ring for it, and since 0.7.3 a
# full ring makes the writer wait instead of dropping - but the shape of
# the trade stands (a slow sync is now write latency):
# always is for devices that can sustain it, and the startup log tells
# you whether yours can.  everysec fsyncs on a timer, so the ring drains
# freely between them and the question does not arise.
#fsync = everysec
# 64, or 256 where the probe measures ms-class storage.  The log takes
# segments x segment_mb of disk from the start.
#segment_mb = 64
# segments is the floor, always kept (segments_min says the same);
# segments_max lets the log grow under a burst - in the background, when
# it is half full or its free segments would last under three snapshots -
# and give the extra segments back after five quiet minutes.  Unset, the
# ring is fixed at segments.  Up to 256; never into the last of the disk
#segments = 8
#segments_max = 32
# per-thread WAL ring.  Under everysec and no, appends never block a
# worker, so an overrun drops the record and counts it (`dropped` in
# stats, and logged) - a write the client was told succeeded.  Under
# always the writer waits for room instead (`ring_waits` in stats).  The ring
# does not have to hold the workload, only what arrives during ONE
# drain+fsync cycle, which is why fsync latency is what governs its
# depth.  Left unset with a probe available, fsync = always derives it
# from the measured p99; set it here to pin it yourself.
#ring_kb = 1024
# what a full log does.  wait (the default): a connection that writes is
# held, unread, while the WAL catches up - its worker serves the others -
# and a log with no free segment waits for the snapshot it asks for, so
# nothing acknowledged is lost or refused; the cost is write latency.
# heal: the record is dropped from the log (it stays in memory) and the
# node heals - refusing writes until a snapshot lands; fsync = always
# still waits on a full ring
#on_full = wait
# A WAL record of a type this build does not know was written by a newer
# build: the start refuses rather than drop it (a record the loaded
# snapshot already covers never refuses).  "skip" starts without such
# records and logs how many - keep it while an older build runs.
#unknown_records = refuse
# RDB snapshot triggers, Redis-style "seconds changes", comma-separated
# on ONE line and OR-ed - a second save line replaces the first.  Unset:
# 900 1, 300 10, 60 10000.  "save = off" turns off these timed rules,
# NOT snapshots: the WAL still asks for one when its free segments run
# short, or a busy ring would overrun and FAIL the node.  With mode =
# eager it is a data-loss configuration (replica copies are only in the
# snapshots).
#save = 900 1, 300 10, 60 10000
# rate limit for the snapshot walker's writes, MB/s (unset: a quarter of
# the probe's sequential rate, else 64)
#rdb_mb_s = 64

#[cluster]
# Membership is AUTOMATIC: every node with the same group (or, in
# discovery = unicast, the same seeds) and cluster secret finds the
# fleet by itself - node ids are assigned by the elected master, there
# is nothing per-node to configure.  The SAME config file works on
# every node.
#multicast = 239.68.68.1:6480
# no multicast (cloud VPCs, most Kubernetes pod networks): find the fleet
# through seeds instead.  `port` is the cluster port (UDP and TCP);
# `seeds` are host names or addresses of a few members, re-resolved every
# few seconds - a seed may be down, and a name may move.  The beats then
# go by unicast to every seed and every member this node has heard of.
#discovery = unicast
#port = 6480
#seeds = perfcached-0.perfcached, perfcached-1.perfcached
# frames larger than this go over TCP instead of as IP fragments, which
# cloud networks and tunnels may drop: unicast mode's "frame lane" (on
# lane_port - the cluster port + 2 unless set, the same on every node),
# and in either mode replication groups to the peer's relay port (TCP on
# the relay port's number).  1232 = what IPv6 guarantees on any path.
# 0: everything goes as datagrams - no lane, no replication over TCP.
#max_datagram = 1232
#lane_port = 6482
# unicast mode: a peer whose UDP went silent while it answered on TCP is
# sent everything over the lane; every lane_retry_s this node asks it, by
# UDP, whether UDP works again, and an answer by UDP puts it back on UDP.
#lane_retry_s = 30
# unicast mode, cold start: a node with no cluster id founds a cluster
# only once it sees this many blank nodes (itself included) - set it to
# the fleet's size so a node whose seeds are not up yet waits instead of
# founding a cluster of one.  0 = do not count.
#expect = 3
# where this node's identity comes from.  auto: the machine's DMI uuid,
# else its NIC MAC, else the identity file (a disk clone copies that).
# env: $PERFCACHED_PLATFORM_KEY - in Kubernetes set it to the pod's
# metadata.uid (downward API), so a rescheduled pod is a new member.
# file: the identity file only (a StatefulSet's volume keeps it).  A
# named source that is missing refuses the start.
#identity_source = auto
# the TTL of the cluster's multicast datagrams.  1 (the default) keeps
# the fleet on one L2 segment; more lets multicast routing (PIM, static
# routes) carry it across segments - the unicast planes must route too,
# see PRODUCTION.md.  Not measured over WAN links.
#multicast_ttl = 1
# pin the cluster id (a UUID, or any name - hashed).  Unset: the node that
# founds the cluster mints one and every member adopts it.  A node holding
# one cluster's id never joins another, so a pin per environment keeps
# staging and production apart even on one multicast group.  A pin that
# disagrees with the id in the state directory refuses the start.
#cluster_id = production
# the most members this fleet admits, this node included (1-257; unset =
# the build's limit, 256 peers + this node).  A join past it is REFUSED
# with a message on both sides, and the refused node stops rather than
# founding a second cluster.
#max_members = 257
# own unicast address (the data plane binds it); default = the
# interface a route toward the group picks - set it on multi-homed hosts
#advertise = 10.0.0.1
# mixed into an identity derived from the machine, so the same machine in
# two fleets (two daemons, one host) is two members
#site_salt = fleet-b
# pub/sub relays and (0.7.4) eager replication's write-path pushes have a
# UDP port of their own, read by threads of their own, so neither fills
# the socket membership reads from.  Default: the cluster port + 1, so a firewall
# between nodes must admit BOTH ports.  A peer whose relay port does not
# answer is sent relays on the cluster socket instead - found within a few
# seconds and logged by the node itself - and probed again every second.
#pubsub_port = 6481
# threads receiving on it: auto (the default) = half the workers, rounded
# up, at most 15; 0 = no relay port, relays and pushes share the cluster
# socket and its thread
#pubsub_rx_threads = auto
# which publishes the other nodes relay to THIS one: all of them, or only
# those that may match a subscription held here.  `interested` sends the
# node's channels (as a 32 KiB Bloom filter) and patterns to its peers,
# and a new subscription at once; a publish on another node in the moment
# before that update lands is not relayed here.  Each node chooses for
# itself, so a fleet can move one node at a time; older builds relay
# everything regardless.
#pubsub_relay = all
# THE CLUSTER OWNS THE COLLECTION CONFIG.  Declaring `collections`
# here makes this description authoritative: ONE mode for the whole
# cluster, over an EXHAUSTIVE set of collections.  Members then carry no
# private collections, and a peer whose config differs is REFUSED at
# join (loudly, naming both sides) instead of silently exchanging data
# it will misinterpret - two nodes running one collection as store and
# shard lost every write between them, in silence, before this existed.
# Without `collections` the legacy per-collection form still parses and
# warns: nothing checks that your peers agree.
# A deployment needing two modes runs TWO clusters on distinct groups.
#mode = shard                 # store | eager | proxy | shard | spread
#collections = sessions, dialogs
# mode = spread only, and required there: how many nodes hold each record
# (2 up to the fleet's size; 1 is shard)
#replicas = 3
# how long a miss waits for a pull answer before reporting not-found
#pull_timeout_ms = 80
# a confirmed fleet-wide miss is remembered this long
#negative_ms = 300
# deletes shield against racing pulls this long
#tombstone_ms = 2000
# a delete is forgotten once every member holds it (tombstone_acks = yes),
# else after tombstone_retain_s; tombstone_retain_max caps how many are
# kept either way
#tombstone_acks = yes
#tombstone_retain_s = 900
#tombstone_retain_max = 250000
# on a multicast fleet a delete goes to the group once (auto), or one
# copy to each peer (off)
#data_multicast = auto
# the eager repair sweep compares per-slot digests with each peer and
# walks only the slots that differ (yes), or walks every slot (no)
#sweep_digests = yes
# a restarted node first asks one witness for the deletes made since its
# last snapshot began (yes), and asks the fleet about every replayed key
# when the witness cannot vouch for that (or with no) - at most
# reconcile_rate_max keys a second
#reconcile_fast = yes
#reconcile_rate_max = 1024
# A node back after an absence longer than this - a restart or a split -
# drops what it stored before and pulls the fleet's state (RECOVERING
# meanwhile) instead of reconciling record by record.  A node back from a
# split that no peer can witness does so whatever the time.  0 = never by
# time; at most 31536000 (a year).
#resync_after_s = 86400
# One thread applies replicated records, answers pulls and runs the
# control plane; another keeps the heartbeat going.  If the first makes no
# progress for this long the node reports itself STALLED (with the
# reason), peers and clients steer new work to other members, and it
# returns to READY by itself once the thread has moved steadily for the
# same time.  It stays a member and refuses nothing.  0 = off; otherwise
# 1000 and up.  A whole-process pause (SIGSTOP, a VM pause) is not a stall.
#apply_stall_ms = 10000
# Replicated records are applied by the thread that receives them.  With
# N >= 2 the receiver keeps the socket and the decrypt and hands each
# record to one of N apply threads by a hash of its key, so every record
# of a key is applied by the same thread in arrival order.  The receiver
# still decrypts everything, which bounds the gain at roughly 3x; a hot
# key pins one thread.  1 = the receiver alone, as before.
#
# The hand-off is not free: measured 2026-09-22 on an idle 16-core
# receiver at ~1.3M records/s offered, CPU per applied record is
# 0.95 us at one thread, 1.75 at two and 2.19 at four.  Raise this only
# when the receiving thread is demonstrably the bottleneck - at that
# load 2 and 4 both keep up with everything the author can produce.
#apply_threads = 1
# how many cluster requests may be PARKED at once, waiting on a peer.
# This is backpressure, not a buffer: a forward or pull that cannot park
# a Sentinel as the upstream (0.7.5): name one sentinel and the master it
# watches and that master's replicas become the upstreams, followed
# through failovers; upstream_sentinel_master names the master when it
# watches several, upstream_sentinel_password is the sentinels' own AUTH
#upstream = redis://reader@10.0.0.20:26379
#upstream_sentinel_master = mymaster
#upstream_sentinel_password = <the sentinels' password>
# is REFUSED - a routing client is told -TRYAGAIN and should retry - so
# this bounds how much state one pipelining client can make the daemon
# hold while a peer is slow.
#
# A client that cannot compute the owner (any RESP client) forwards
# nearly every key, so it parks far more than a cluster-aware one: 200
# connections at pipeline 64 measured a peak of 2699 slots.  The default
# of 8192 leaves headroom over that; the old 1024 refused such a client
# outright.
#
# SIZE IT FROM MEASUREMENT, not from guessing - stats.cluster.pend_peak
# is the high-water mark and pend_exhausted counts what a too-small
# table refused.  peak at max with a nonzero refusal count means raise
# it (or route the clients).  It costs memory in three places at once:
# the parked table, a completion queue per worker, and a park table per
# worker, so roughly 2.3 KB per slot per worker at the default.
#max_pending = 8192

# one section per collection; the name is what clients pass as "col"
[collection sessions]
buckets_log2 = 18
# store mode + pull: a local miss fetches from peers and KEEPS a copy
# (read-heavy shared data; every node converges on the working set)
#pull = 1
# eager: the rebalancer's distributor pushes EVERY record to all
# peers in the background (10s sweep, budgeted, idempotent retries;
# rejoining nodes resync in full).  For keyspaces whose TTLs are too
# short to ever converge via pull-on-miss.  Requires [cluster].
#mode = eager
# proxy mode: keys live on exactly ONE node (placement by free memory),
# reads are served through without storing, writes forward to the
# holder, the 10s rebalancer keeps the fleet level - fleet capacity is
# the sum of arenas.  Requires [cluster].
#mode = proxy
# shard mode: keys live on exactly ONE node chosen DETERMINISTICALLY
# (rendezvous hashing over member addresses, CRUSH-style): no locator,
# no placement races, an owner miss is authoritative and fast, and
# counters serialize at the owner from any ingress.  Membership changes
# reshard automatically (only the moving keys travel; reads fall back
# to a broadcast during the move).  v1 assumes comparable arena sizes.
# Requires [cluster].
#mode = shard
# a pure cache: never appended to the WAL, never in a snapshot - a restart
# starts it empty on this node (in a fleet, the peers still refill it, by
# the repair sweep and pulls).  Default yes.
#durable = no
# this collection's own log_events, notify_events, autoscale and
# redis_types, over [daemon]'s
#log_events = expired, remove

#[collection counters]
#buckets_log2 = 14

# Read-through from a Redis upstream (GUIDE.md: "Read-through: taking
# over from Redis"; doc/upstream.md in full).  A key this collection does not hold, matching one of the
# patterns, is read from the upstream on first use - never written to it.
# A key the fleet writes or deletes is tracked in the companion collection
# "tokens.nofall", created with it.  Point it at ONE replica (not a
# round-robin proxy: tracking needs every connection on one server), with
# an ACL user that can only read, plus +info; its password is the
# collection's upstream_password (0.6.1 - each read-through collection
# may front its own Redis, with its own password).
#[collection tokens]
#buckets_log2 = 15
#upstream = redis://reader@10.0.0.12:6379/0
#upstream_password = <the reader's password>
# another perfcached as the upstream is refused (a ring of read-throughs
# is a fetch storm); yes allows it, one hop: that node never reads
# through for this one (0.6.1)
#upstream_allow_perfcached = no
# several upstreams (0.6.1): up to 32 (0.7.5; 8 before), comma-separated; replicas only, the
# master read only while no replica serves (if you allow that); balance
# (the fewest fetches in flight) or failover (one active, the primary
# first; it takes over again once it has served for the hold)
#upstream = redis://reader@10.0.0.13:6379/0, redis://reader@10.0.0.14:6379/0
#upstream_role = replica
#upstream_master_fallback = no
#upstream_mode = balance
# upstream_mode = failover only: the primary, and whether it takes over
# again once it has served for the hold
#upstream_primary = 10.0.0.13:6379
#upstream_preempt = yes
#upstream_preempt_hold_s = 30
# REQUIRED with upstream: the keys that may be read through ("*" for all,
# said explicitly)
#upstream_prefixes = sess:*, tok:*
#upstream_timeout_ms = 500
# connections to each upstream server
#upstream_conns = 2
#upstream_negative_ms = 2000
# an invalidation within this many ms of this node's own write-through is
# its echo: the key is fetched again, not left empty (0 = drop, as 0.6.x)
#upstream_echo_ms = 2000
# the replicas a listed master's ROLE names (0.7.5): auto adds them only
# when the master answers at the address dialled - behind a proxy they are
# shown, not used; yes dials them directly; no ignores them
#upstream_discover = auto
# an upstream that is a Redis Sentinel (0.7.5): the master it watches, the
# replicas and the other sentinels it names become the upstreams, read
# again every 10 s; a sentinel itself is never read from.  Name the master
# when it watches more than one; its own password if it asks for one
#upstream_sentinel_master = mymaster
#upstream_sentinel_password = <the sentinels' password>
# rediss:// (0.7.5): the upstreams over TLS - all of the collection's or none.
# The certificate is checked against upstream_tls_ca (the system's store when
# not given) and the URL's host, or upstream_tls_name when the certificate
# names a host and the URL an address.  A Redis with tls-auth-clients yes
# wants a client certificate (both lines).  verify = no checks nothing and is
# warned about; a self-signed certificate can be named in upstream_tls_ca.
#upstream = rediss://reader@10.0.0.12:6380/0
#upstream_tls_ca = /etc/perfcached/redis-ca.pem
#upstream_tls_name = redis.example.net
#upstream_tls_cert = /etc/perfcached/redis-client.pem
#upstream_tls_key = /etc/perfcached/redis-client.key
#upstream_tls_verify = yes
# after a tracking gap (a restart, a lost tracking connection) the records
# written through are dropped; this many of their names are fetched again in
# the background at upstream_drain_rate (0 = off: cold, as 0.6.x)
#upstream_rewarm_max = 100000
#upstream_tracking = on
#upstream_on_error = error
# refuse every write to the collection (it only mirrors its upstream);
# allow (the default) lets a write make the key the fleet's own; through
# (0.6.2) sends every write to the upstream's master first - list it beside
# the replicas - and reads the keys back, so Redis keeps every write
#upstream_writes = allow
# under through: a command perfcached does not know is classed by Redis
# and passed (pass, the default) or answered "unknown command" (refuse)
#upstream_unknown = pass
# ...and a passed reply larger than this (KB) is refused, never cut
#upstream_pass_max_kb = 1024
# under through: writes waiting for the master, at most - past it a write
# is refused at once ("not applied"); upstream_timeout_ms runs from the
# queueing, and a write with under a quarter of it left is not sent
#upstream_write_queue = 10000
# under through: the writer's own Redis user and password (0.6.4) - the
# fetch and tracking connections keep upstream_password, so the readers'
# user needs no write rights; without these the writer uses that too
#upstream_write_user = writer
#upstream_write_password = <the writer's password>
# the drain sweep (perfcli -E <enable> updrain tokens) and the upfill sweep
# move at most this many keys a second; 0 = no cap
#upstream_drain_rate = 5000
# ... and this many MB of values a second (0.6.5); 0 = no cap.  At the
# defaults an upfill sweep takes about a quarter of the writer thread at
# most, whatever the values' size
#upstream_drain_mb_rate = 16
