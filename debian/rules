#!/usr/bin/make -f
# perfcached Debian packaging: dh_auto_install runs the tree's own FHS install; the units come from
# debian/ (policy's /usr/lib/systemd/system), not the Makefile's /etc/systemd/system.

# the build has no .git, so the revision defaults to the Debian version (traceable); a driver that
# knows the git revision exports PC_BUILD_REV
PC_BUILD_REV ?= $(shell dpkg-parsechangelog -SVersion 2>/dev/null || echo unknown)
export PC_BUILD_REV

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# the packages send alert mail through curl's SMTP client (the Makefile's PC_MAIL ?= none yields to
# this); libcurl reaches Depends through ${shlibs:Depends}
export PC_MAIL = libcurl

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- PC_BUILD_REV=$(PC_BUILD_REV) PC_DASH=yes perfcached perfcli perfdump perfload perfcached-dashboard libperfd.a libperfd.so

# two binary packages from one tree: the clustered edition first, then a clean and a standalone
# build (-DPC_EDITION_STANDALONE) - make tracks neither, so the clean keeps cluster objects out
override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/perfcached PREFIX=/usr \
		PC_BUILD_REV=$(PC_BUILD_REV) PC_DASH=yes
	# the daemon reads this to know it is a package install
	mkdir -p debian/perfcached/usr/share/perfcached
	echo package > debian/perfcached/usr/share/perfcached/INSTALL-MODE
	# the dashboard is its own package - the Makefile put it into the clustered tree; its unit comes
	# from debian/ like the daemon's (dh_installsystemd, disabled)
	mkdir -p debian/perfcached-dashboard/usr/bin \
		debian/perfcached-dashboard/etc/perfcached \
		debian/perfcached-dashboard/usr/lib/sysusers.d
	mv debian/perfcached/usr/bin/perfcached-dashboard debian/perfcached-dashboard/usr/bin/
	mv debian/perfcached/etc/perfcached/perfcached-dashboard.conf.example \
		debian/perfcached-dashboard/etc/perfcached/
	mv debian/perfcached/usr/lib/sysusers.d/perfcached-dashboard.conf \
		debian/perfcached-dashboard/usr/lib/sysusers.d/
	rm -f debian/perfcached/etc/systemd/system/perfcached-dashboard.service
	$(MAKE) clean
	dh_auto_build -- PC_EDITION=standalone PC_BUILD_REV=$(PC_BUILD_REV) \
		perfcached perfcli perfdump perfload libperfd.a libperfd.so
	./perfcached -V | head -1 | grep -q ' standalone$$' || \
		{ echo "the second build is not the standalone edition: $$(./perfcached -V | head -1)" >&2; exit 1; }
	$(MAKE) install PC_EDITION=standalone PC_DASH=no \
		DESTDIR=$(CURDIR)/debian/perfcached-standalone PREFIX=/usr \
		PC_BUILD_REV=$(PC_BUILD_REV)
	mkdir -p debian/perfcached-standalone/usr/share/perfcached
	echo package > debian/perfcached-standalone/usr/share/perfcached/INSTALL-MODE
	# each unit is contrib/'s with the package's prefix (it must start a binary the package installs);
	# the client library goes to libperfd0 (.so.N) and libperfd-dev (header, archive, link, .pc)
	mkdir -p debian/libperfd0/usr/lib debian/libperfd-dev/usr/lib \
		debian/libperfd-dev/usr/include
	mv debian/perfcached/usr/lib/libperfd.so.* debian/libperfd0/usr/lib/
	mv debian/perfcached/usr/lib/libperfd.so debian/perfcached/usr/lib/libperfd.a \
		debian/perfcached/usr/lib/pkgconfig debian/libperfd-dev/usr/lib/
	mv debian/perfcached/usr/include/perfd.h debian/libperfd-dev/usr/include/
	rmdir debian/perfcached/usr/include
	rm -rf debian/perfcached-standalone/usr/lib/libperfd.* \
		debian/perfcached-standalone/usr/lib/pkgconfig \
		debian/perfcached-standalone/usr/include
	# the upgrade helper drives the release tarballs' /opt prefix layout; a package is upgraded by the
	# package manager, so neither package carries the helper, its units or its example settings
	for p in perfcached perfcached-standalone; do \
		rm -f $(CURDIR)/debian/$$p/usr/sbin/perfcached-upgrade \
			$(CURDIR)/debian/$$p/etc/systemd/system/perfcached-upgrade.path \
			$(CURDIR)/debian/$$p/etc/systemd/system/perfcached-upgrade.service \
			$(CURDIR)/debian/$$p/etc/perfcached/upgrade.conf.example; \
		rmdir --ignore-fail-on-non-empty $(CURDIR)/debian/$$p/usr/sbin || true; \
		rm -f $(CURDIR)/debian/$$p/etc/systemd/system/perfcached.service; \
		rmdir -p --ignore-fail-on-non-empty \
			$(CURDIR)/debian/$$p/etc/systemd/system || true; \
		u=debian/perfcached.service; \
		[ $$p = perfcached ] || u=debian/$$p.perfcached.service; \
		bin=$$(sed -n 's|^ExecStart=\([^ ]*\).*|\1|p' $$u); \
		test -x "$(CURDIR)/debian/$$p$$bin" || \
			{ echo "$$u starts $$bin, which $$p does not install" >&2; exit 1; }; \
	done

# the library's shlibs - a program built against libperfd0 depends on
# at least the version that built it
override_dh_makeshlibs:
	dh_makeshlibs -plibperfd0 -V 'libperfd0 (>= 0.5.9~)'

# perfcached-standalone's unit is perfcached.service too: the same name
# for the same daemon, whichever edition is installed
override_dh_installsystemd:
	# a fleet restarts members first and the master last, never by apt:
	# an upgrade leaves the running daemon (and dashboard) as it is
	dh_installsystemd -pperfcached --no-stop-on-upgrade
	dh_installsystemd -pperfcached-standalone --name=perfcached --no-stop-on-upgrade
	# shipped disabled: one enabled node shows the whole fleet
	dh_installsystemd -pperfcached-dashboard --no-enable --no-start --no-stop-on-upgrade

# the suite starts real daemons and wants privileges no buildd grants: gate on the smoke tests
# matrix.sh trusts instead, including the canary that MUST fail
override_dh_auto_test:
	$(MAKE) selftest selftest_broken noisetest
	./noisetest
	PC_SELFTEST_LIGHT=1 ./selftest
	@if ./selftest_broken >/dev/null 2>&1; then \
		echo "selftest_broken PASSED - the canary is dead"; exit 1; \
	fi
	@echo "selftest_broken failed as it must"
