#!/bin/sh
# perfcached-dashboard.service runs as its own account, so the client secret in its config is
# readable by the dashboard alone; create it now so the unit can be enabled at once.
set -e

case "$1" in
configure)
	if command -v systemd-sysusers >/dev/null 2>&1; then
		systemd-sysusers /usr/lib/sysusers.d/perfcached-dashboard.conf || true
	fi
	;;
esac

#DEBHELPER#

exit 0
